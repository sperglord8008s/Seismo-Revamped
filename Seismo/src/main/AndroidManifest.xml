<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.ariwilson.seismo">
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:forceDarkAllowed="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".Seismo" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Help" android:exported="false" />
        <activity android:name=".Export" android:exported="false" />
        <provider
            android:name=".CacheFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
